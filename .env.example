# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas connection string. Required - the app fails to start
# without it (no insecure default).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority"

# There is no ADMIN_USER / ADMIN_PASS env-var login anymore. Create the
# first admin account with scripts/create_admin.mjs, e.g.:
#   ADMIN_NAME="Clinic Owner" ADMIN_EMAIL="owner@clinic.com" \
#   ADMIN_PASSWORD="a-strong-password" MONGODB_URI="..." \
#   node scripts/create_admin.mjs
